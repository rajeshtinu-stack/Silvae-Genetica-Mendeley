<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0" class="in-text" default-locale="en-US">
  <info>
    <title>Silvae Genetica - manuscript style</title>
    <id>http://www.zotero.org/styles/silvae-genetica-manuscript</id>
    <link href="https://sciendo.com/journal/SG" rel="documentation"/>
    <updated>2026-08-19T00:00:00+00:00</updated>
  </info>
  <macro name="author">
    <names variable="author">
      <name name-as-sort-order="all" sort-separator=" " initialize-with="" delimiter=", " delimiter-precedes-last="never" and="text"/>
    </names>
  </macro>
  <macro name="author-short">
    <names variable="author">
      <name form="short" et-al-min="3" et-al-use-first="1" and="text"/>
    </names>
  </macro>
  <citation et-al-min="3" et-al-use-first="1">
    <layout prefix="(" suffix=")" delimiter="; ">
      <group delimiter=" ">
        <text macro="author-short"/>
        <date variable="issued"><date-part name="year"/></date>
      </group>
    </layout>
  </citation>
  <bibliography hanging-indent="false" et-al-min="100" et-al-use-first="100">
    <sort><key macro="author"/><key variable="issued"/></sort>
    <layout suffix=".">
      <text macro="author" suffix=" "/>
      <date variable="issued" prefix="(" suffix=") "><date-part name="year"/></date>
      <text variable="title" suffix=". "/>
      <choose>
        <if type="article-journal">
          <text variable="container-title" font-style="italic" suffix=" "/>
          <text variable="volume"/>
          <text variable="issue" prefix="(" suffix=")"/>
          <text variable="page" prefix=":"/>
        </if>
        <else-if type="book">
          <text variable="edition" suffix=" edn. "/>
          <text variable="publisher"/>
          <text variable="publisher-place" prefix=", "/>
        </else-if>
        <else>
          <text variable="publisher"/>
          <text variable="publisher-place" prefix=", "/>
        </else>
      </choose>
      <text variable="DOI" prefix=". https://doi.org/"/>
    </layout>
  </bibliography>
</style>
